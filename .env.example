# Supabase project (public anon key only for the front-end — never commit service role keys)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Writers / bot runners (scripts/push-status.mjs). Never prefix with VITE_.
# Service role bypasses RLS; keep it server-side / CI secrets only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SHA-256 hex digest of the office site password (build-time inject).
# Generate: echo -n 'your-password' | sha256sum
# Never put OFFICE_SITE_PASSWORD or plaintext passwords in the repo.
VITE_OFFICE_PASSWORD_HASH=

# Optional public webhook. The page POSTs portal handoffs here.
# Never a service-role key, secret, or signed URL — Vite inlines VITE_ values into the bundle.
# Leave unset to keep the handoff in the browser queue only.
# VITE_HANDOFF_WEBHOOK_URL=https://example.com/hooks/virtual-office
